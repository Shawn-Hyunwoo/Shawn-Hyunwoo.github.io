@misc{kim2026padopauli,
  abbr           = {arXiv},
  bibtex_show    = {true},
  title          = {PADO-Pauli: A GPU-Accelerated Implementation of Pauli Propagation},
  author         = {Kim, Hyunwoo and Lee, Youngseok},
  year           = {2026},
  eprint         = {2610.17755},
  archivePrefix  = {arXiv},
  primaryClass   = {quant-ph},
  arxiv          = {2610.17755},
  url            = {https://arxiv.org/abs/2610.17755},
  code           = {https://github.com/Norma-Q/PADO-Pauli},
  abstract       = {Variational quantum algorithms utilize parameterized circuits many times during training, at new parameter values, over batches of data, and with gradients. Pauli propagation approximates the expectation values of such circuits classically by evolving the observable in the Heisenberg picture as a truncated sum of Pauli strings. We present PADO-Pauli, a GPU engine for Pauli propagation that compiles a circuit and its observables once into sparse matrices in which each rotation angle contributes only a cosine and a sine factor, so every later evaluation reuses the compiled program. It evaluates batches of parameters and data inputs embedded as rotation angles. By default its gradients come from a vector-Jacobian product registered with PyTorch's automatic differentiation, so they flow through the angles to any classical layer that produces them. PADO-Pauli also provides truncation by Pauli weight and coefficient size, and noise channels. Zero-filtering removes terms that do not contribute to an expectation value in the all-zero reference state and makes the batched forward pass about 1.5 times faster. Compared to cuPauliProp on an NVIDIA A100, PADO-Pauli evaluates up to 10 times faster on 4 to 12 qubits and uses up to 3.1 times less memory on 16 qubits. We check its accuracy against exact statevector simulation up to 28 qubits. These features make PADO-Pauli a practical toolkit for training variational quantum algorithms, including quantum machine learning models.},
  selected       = {true}
}

@inproceedings{kim2026safe,
  abbr           = {QCE},
  bibtex_show    = {true},
  title          = {SAFE ma-QAOA: Surrogate-Assisted and Fine-Tuning Enhanced Multi-Angle QAOA with Parameter Distillation},
  author         = {Kim, Hyunwoo and Lee, Youngseok},
  booktitle      = {Proceedings of the IEEE International Conference on Quantum Computing and Engineering (QCE)},
  year           = {2026},
  eprint         = {2605.23377},
  archivePrefix  = {arXiv},
  primaryClass   = {quant-ph},
  arxiv          = {2605.23377},
  url            = {https://arxiv.org/abs/2605.23377},
  abstract       = {The multi-angle Quantum Approximate Optimization Algorithm (ma-QAOA) extends the Quantum Approximate Optimization Algorithm (QAOA) by assigning a larger number of independent variational parameters, thereby increasing expressivity and improving performance at low circuit depths. However, this larger parameterization makes training more difficult and requires repeated circuit evaluations for gradient-based optimization. In this work, we propose the Surrogate-Assisted and Fine-tuning Enhanced (SAFE) framework. SAFE first uses Low-Weight Pauli Propagation (LWPP) as a classical surrogate for pre-training ma-QAOA parameters before exact optimization. SAFE then applies parameter distillation, which removes angles that remain near zero after surrogate pre-training. Finally, SAFE performs exact fine-tuning by optimizing the remaining active parameters using the exact energy objective. We evaluate SAFE on instances of the Sherrington-Kirkpatrick model, two-dimensional square-lattice spin glass, and Max-Cut. SAFE with distillation provides the strongest overall results relative to exact-only: (i) a 64.3 percent reduction in active parameter count and (ii) a 94.5 percent reduction in estimated QPU workload. Within the SAFE workflow, adding distillation further reduces the optimizer steps to the near-optimal regime by 44.4 percent relative to without distillation. These results provide evidence that SAFE ma-QAOA can accelerate convergence to high-quality solutions while reducing the required quantum resources for exact fine-tuning, offering a resource-efficient route toward expressive ma-QAOA on NISQ hardware.},
  additional_info = {. To appear. H. Kim and Y. Lee contributed equally. Oral presentation in the Technical Papers Track (Quantum Algorithms) at IEEE Quantum Week (QCE 2026), Toronto; invited talk at the Waterloo Quantum Club (WQC), University of Waterloo; posters at Quantum Future Korea 2026 and the Conference on Quantum Information (CQI 2026, held with Quantum Korea 2026), Seoul.},
  selected       = {true}
}

@inproceedings{kim2026padopauliqce,
  abbr           = {QCE},
  bibtex_show    = {true},
  title          = {PADO-Pauli: A GPU-Accelerated Implementation of Pauli Propagation},
  author         = {Kim, Hyunwoo and Lee, Youngseok},
  booktitle      = {Proceedings of the IEEE International Conference on Quantum Computing and Engineering (QCE), Poster Track},
  year           = {2026},
  code           = {https://github.com/Norma-Q/PADO-Pauli},
  abstract       = {We present PADO-Pauli, a GPU-accelerated simulation engine built for the repeated evaluation of variational quantum algorithms and quantum machine learning. PADO-Pauli implements Pauli propagation, a Heisenberg-picture method that evolves the measured observable as a sum of Pauli strings. Bounded truncation of that sum yields a compact, reusable Pauli propagation classical surrogate (PPS). Two ideas drive its efficiency: (i) PADO-Pauli expresses the Pauli propagation paths as reusable sparse tensor maps, and (ii) a zero-filtering that keeps only the valid paths that contribute to the final observable, shrinking the working set by orders of magnitude with no change to any result. PADO-Pauli can be readily integrated with machine learning modules (i.e., Torch), enabling features such as end-to-end differentiation, composition with classical layers, parameter batching and data sweeps. Through these capabilities PADO-Pauli outperforms prior Pauli propagation engines: on a 12-qubit square-lattice Ising QAOA it evaluates 9.7 times faster and trains 14.5 times faster than cuPauliProp at up to 50 times lower memory. PADO-Pauli can also treat systems beyond 100 qubits: on the 127-qubit kicked-Ising model it closely reproduces the error-mitigated IBM Eagle hardware result. We therefore offer PADO-Pauli as a tool to accelerate QML workflows with GPUs while minimizing dependence on quantum resources.},
  additional_info = {. Two-page poster paper, to appear. H. Kim and Y. Lee contributed equally. Poster at IEEE Quantum Week (QCE 2026), Toronto; also presented as a poster at the ML4QT Symposium 2026, Waterloo. Full paper: arXiv:2610.17755.},
  selected       = {false}
}

@misc{lee2026iqp,
  abbr           = {arXiv},
  bibtex_show    = {true},
  title          = {Trainability and Mode Separation of Mixed IQP-QCBMs},
  author         = {Lee, Youngseok and Kim, Hyunwoo},
  year           = {2026},
  eprint         = {2607.27883},
  archivePrefix  = {arXiv},
  primaryClass   = {quant-ph},
  arxiv          = {2607.27883},
  url            = {https://arxiv.org/abs/2607.27883},
  abstract       = {Quantum circuit Born machines (QCBMs) based on instantaneous quantum polynomial-time (IQP) circuits are promising quantum generative models for their classical trainability. It is known that their ancilla-free form avoids barren plateaus under certain initializations, but remains non-universal. Although adding ancilla qubits raises the expressivity, whether the ancilla-extended model retains local trainability remains unknown. We propose the mixed IQP-QCBM, which generalizes the ancilla-extended circuit as a weighted mixture of ancilla-free IQP circuits, called branches. For a polynomial number of branches, we prove local barren-plateau avoidance from data-agnostic and, under certain assumptions, data-dependent initializations. We further show that the mixed IQP-QCBM can surpass the best ancilla-free IQP circuit only if its branches generate a number of distinct distributions. In particular, we focus on a behavior we call mode separation, in which each branch captures a particular feature of the target. Mode separation is hard to attain from an initialization whose branches generate the same distribution: the gradients that would separate them are suppressed while the distributions they generate remain close. This motivates cluster initialization, which assigns a different unsupervised data cluster to each branch and provides an initial degree of mode separation. Exact calculations on two 16-bit datasets support the barren-plateau and gradient-suppression claims. On four benchmarks, binary clusters, a two-dimensional Ising model, binarized MNIST, and a 484-spin glass, cluster initialization converges fastest and reaches the lowest mean test MMD². We observe that, when achieving the lowest test MMD², the mixed IQP-QCBM contains branches specialized to distinguishable data features such as blob patterns, magnetization sectors, or digit shapes.},
  additional_info = {. Oral presentation at the ML4QT Symposium 2026 (Machine Learning to Advance Quantum Technologies), Waterloo; accepted as a poster at QTML 2026 (Quantum Techniques in Machine Learning), Stellenbosch.},
  selected       = {true}
}
